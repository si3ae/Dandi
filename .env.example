# ===========================================================================
# 단디 환경변수 — 이 파일을 `.env.local`로 복사한 뒤 값을 채우세요.
# `.env.local`은 절대 git에 커밋하지 마세요 (.gitignore에 이미 포함).
# ===========================================================================

# ── OpenAI (Whisper 음성 인식 전용) ────────────────────────────────────────
# 발급:  https://platform.openai.com/api-keys
# 형식:  "sk-..." 또는 "sk-proj-..." 로 시작
# 권한:  Audio(Whisper) 호출 가능한 최소 권한으로 발급 (Project key 권장)
# 요금:  Whisper는 분당 $0.006 수준. 월 한도를 대시보드에서 걸어두세요.
# 유출시: 위 링크에서 해당 키 "Revoke" 후 새 키로 재발급, .env.local 업데이트.
OPENAI_API_KEY=

# ── Anthropic (Claude - 손글씨/영수증/세금계산서/음성 파싱) ───────────────
# 발급:  https://console.anthropic.com/settings/keys
# 형식:  "sk-ant-api03-..." 로 시작하는 긴 문자열
# 권한:  Workspace Admin이 아닌 "Developer" 권한의 Workspace key 권장
# 유출시: 위 링크에서 "Revoke" 후 재발급, .env.local 업데이트.
#
# ⚠️ 두 키 모두 서버사이드(/api/* 라우트)에서만 사용되며
#    클라이언트 번들에 포함되지 않습니다. NEXT_PUBLIC_* 접두사를 붙이지 마세요.
ANTHROPIC_API_KEY=

# ── 네이버 클로바 OCR (손글씨 인식 전용, 선택) ────────────────────────────
# 발급:  https://www.ncloud.com/product/aiService/ocr
# CLOVA_OCR_URL: General OCR 또는 Template OCR의 Invoke URL
# CLOVA_OCR_SECRET: Secret Key
# 미설정 시 손글씨도 Claude Vision으로 fallback 됩니다.
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# ── Upstash Redis (레이트리밋, 선택 — 프로덕션 강력 권장) ────────────────
# 발급:  https://console.upstash.com → Redis → Create Database
# 무료 티어: 일 10,000 요청. 전시/파일럿 규모에 충분.
# 미설정 시 인메모리 폴백 (로컬 개발에는 충분, 프로덕션에서는 무력화됨).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase (서버 DB, 선택 — 파일럿 시 강력 권장) ──────────────────────
# 발급:  https://supabase.com → New Project → Settings → API
# 무료 티어: 500MB DB, 월 50,000 요청. 파일럿 충분.
# 설정 후 supabase-schema.sql을 SQL Editor에서 실행하세요.
# 미설정 시 localStorage만 사용 (기기 변경 시 데이터 유실).
# ⚠️ SUPABASE_SERVICE_ROLE_KEY는 서버 전용. NEXT_PUBLIC_ 붙이지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
